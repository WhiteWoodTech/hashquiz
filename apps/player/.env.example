# Transport mode: "local" (default — talks to Bun dev server on :3030) or "supabase"
VITE_TRANSPORT=local

# Required when VITE_TRANSPORT=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Solo mode scoring: "browser" (default, submit_solo_run RPC) or "edge" (solo-submit Edge Function).
# Must match solo_settings.scoring_mode in the database.
VITE_SOLO_SCORING=browser

# Public player app base URL for share links. Empty = location.origin + "/".
VITE_PLAYER_URL=
