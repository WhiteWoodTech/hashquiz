{
  "name": "quizv",
  "version": "0.0.0",
  "description": "Kahoot-alternative real-time multiplayer quiz platform",
  "type": "module",
  "author": "Maxime Lenne",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "bun@1.1.45",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter='*' build",
    "build:web": "bun run --filter='@quizv/app-host' build && bun run --filter='@quizv/app-player' build",
    "pack": "bun run build:web && bun scripts/pack.ts",
    "test": "bun test",
    "dev": "bun run packages/server/src/cli.ts dev",
    "lint": "bun run lint:md && bun run lint:yaml",
    "lint:md": "markdownlint '**/*.md' --ignore node_modules --ignore dist --ignore pkg --ignore bun.lock",
    "lint:md:fix": "markdownlint '**/*.md' --ignore node_modules --ignore dist --ignore pkg --ignore bun.lock --fix",
    "lint:yaml": "yamllint .",
    "lint:commit": "commitlint --last -V",
    "prepare": "husky",
    "commit": "gitmoji -c",
    "changelog": "conventional-changelog -p gitmoji-config -i CHANGELOG.md -s",
    "changelog:init": "conventional-changelog -p gitmoji-config -i CHANGELOG.md -s -r 0",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run",
    "sync:develop": "bun scripts/sync-develop.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.2",
    "@semantic-release/npm": "^13.1.2",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "conventional-changelog-cli": "^5.0.0",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "conventional-changelog-gitmoji-config": "^1.5.2",
    "gitmoji-cli": "^9.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "markdownlint-cli": "^0.49.0",
    "semantic-release": "^25.0.3",
    "typescript": "^5.4.5"
  },
  "lint-staged": {
    "*.md": "markdownlint --fix",
    "*.{yml,yaml}": "yamllint"
  }
}
